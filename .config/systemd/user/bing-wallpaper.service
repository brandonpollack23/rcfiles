[Unit]
Description=Bing image of the day as the Hyprland wallpaper
Documentation=file://%h/.config/hypr/scripts/bing-wallpaper.sh
After=network-online.target

[Service]
Type=oneshot
# Skip (not fail) when the Hyprland instance this was started from is gone.
# Hyprland imports WAYLAND_DISPLAY and HYPRLAND_INSTANCE_SIGNATURE before
# starting the timer (bing-wallpaper.sh start).
ExecCondition=/bin/sh -c 'test -S "$${XDG_RUNTIME_DIR}/hypr/$${HYPRLAND_INSTANCE_SIGNATURE}/.socket.sock"'
ExecStart=%h/.config/hypr/scripts/bing-wallpaper.sh update
