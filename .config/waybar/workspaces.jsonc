// Workspace buttons, included from config.jsonc. One custom module per
// workspace id (ids are compacted to 1..N in conf/workspaces/order.lua) so each can
// have its own tooltip listing its windows; hyprland/workspaces has no
// per-workspace tooltip. Buttons for workspaces that don't exist hide
// themselves.
//
// group/hidden below works the same way for the hidden (special) workspaces,
// which have no ids: custom/hidden is the special:Hidden scratchpad, and slot N
// of custom/hiddenN is the Nth other one by name, the same ordering
// conf/workspaces/hidden.lua labels H1, H2, ... in the picker. They are their
// own group, and so their own pill, rather than more buttons of
// group/workspaces: they are a separate set of workspaces, reached by toggling
// rather than by switching, and style.css colours the whole pill to say so.
{
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5",
      "custom/ws6",
      "custom/ws7",
      "custom/ws8",
      "custom/ws9",
      "custom/ws10",
      "custom/ws11",
      "custom/ws12",
      "custom/ws13",
      "custom/ws14",
      "custom/ws15",
      "custom/ws16",
      "custom/ws17",
      "custom/ws18",
      "custom/ws19",
      "custom/ws20",
    ],
  },

  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/workspace.py 1",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
  },

  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/workspace.py 2",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
