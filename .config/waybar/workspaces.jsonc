  "group/hidden": {
    "orientation": "horizontal",
    "modules": [
      "custom/hidden",
      "custom/hidden1",
      "custom/hidden2",
      "custom/hidden3",
      "custom/hidden4",
      "custom/hidden5",
    ],
  },

  // The special:Hidden scratchpad: bright while open, dim otherwise.
  "custom/hidden": {
    "exec": "~/.config/waybar/scripts/hidden-workspace.py",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"Hidden\")'",
  },

  "custom/hidden1": {
    "exec": "~/.config/waybar/scripts/hidden-workspace.py 1",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/hidden-workspace.py toggle 1",
  },

  "custom/hidden2": {
