#!/usr/bin/env -S sh -c 'exec amber run --target bash-3.2 "$0" -- "$@"'
//MISE description="Update zsh, tmux, neovim and Omarchy shell plugins (the new versions land in lazy-lock.json and plugins.lock)"

import { dir_exists } from "std/fs"
import { xdg_config_home, xdg_data_home } from "./lib/paths.ab"
import { is_omarchy } from "./lib/os.ab"

main {
    const antidote = "{xdg_data_home()}/antidote"
    $ zsh -c "source {antidote}/antidote.zsh && antidote update" $?
    $ "{xdg_config_home()}/tmux/plugins/tpm/bin/update_plugins" all $?
    $ nvim --headless "+Lazy! sync" +qa $?

    // Shows each plugin's diff and asks before pulling it: they run
    // unsandboxed in the shell.
    if is_omarchy() and dir_exists("{xdg_config_home()}/omarchy/plugins") {
        $ omarchy plugin update $?
        $ mise run plugins-lock $?
    }
}
