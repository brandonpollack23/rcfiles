// GNU Stow on the packages in dotfiles/. Not executable, so mise doesn't list
// it as a task.

import { env_var_get } from "std/env"
import { split_lines, join, text_contains } from "std/text"
import { dir_create } from "std/fs"
import { run, quoted } from "./run.ab"
import { home } from "./paths.ab"
import { is_omarchy } from "./os.ab"

// dotfiles/, from mise.toml.
pub fun dotfiles(): Text {
    return trust env_var_get("DOTFILES")
}

// Every package: the directories in dotfiles/.
pub fun all_packages(): [Text] {
    const dir = dotfiles()
    return split_lines(trust $ ls -1 "{dir}" $)
}

// Stow links a whole directory when it doesn't exist in $HOME yet. For these
// shared ones that would put other programs' files into this repo, so make
// sure they are real directories first.
pub fun ensure_shared_dirs(): Null? {
    const base = home()
    for dir in [".config", ".config/git", ".config/fcitx5", ".config/hypr", ".config/systemd/user", ".config/tmux", ".local/bin", ".local/share", ".claude"] {
        $ mkdir -p "{base}/{dir}" $?
    }
    // Omarchy may not have made this yet when I stow.
    if is_omarchy() {
        $ mkdir -p "{base}/.config/uwsm/env.d" $?
    }
}

// Directories stow has to link whole, as one symlink, not file by file:
// Omarchy saves shell.json by moving a new file over it, which would swap a
// per-file link for a plain file. Of these, the ones `package` (in `repo`)
// has that are real directories under `base`, where stow would go inside.
pub fun unfolded_dirs(package: Text, repo: Text, base: Text): [Text] {
    let found = [Text]
    for dir in [".config/omarchy"] {
        trust $ [ -d "{repo}/{package}/{dir}" ] && [ -d "{base}/{dir}" ] && [ ! -L "{base}/{dir}" ] $
        if status() == 0 {
            found += [dir]
        }
    }
    return found
}

// `stow -v <flags> <packages>` from dotfiles/ into $HOME.
pub fun stow(flags: Text, packages: [Text]): Null? {
    const dir = quoted(dotfiles())
    run("stow -v -d {dir} -t ~ {flags} {join(packages, " ")}")?
}

// The targets (relative to $HOME) that a dry run's output says are in the way.
pub fun stow_conflicts(output: Text): [Text] {
    const found = trust $ printf '%s\n' "{output}" | sed -n -e 's/.* over existing target \(.*\) since .*/\1/p' -e 's/.*existing target is not owned by stow: //p' -e 's/.*existing target is neither a link nor a directory: //p' $
    return split_lines(found)
}

// Whether a `stow -n -v -S` run's output says the package is already linked:
// nothing left to link and nothing in the way.
pub fun nothing_to_stow(output: Text): Bool {
    return not text_contains(output, "LINK: ") and not text_contains(output, "would cause conflicts")
}

// What in $HOME would stop `package` from stowing.
pub fun conflicts_for(package: Text): [Text] {
    const dir = dotfiles()
    const output = trust $ stow -n -v -d "{dir}" -t ~ -R "{package}" 2>&1 $
    return stow_conflicts(output)
}

// Whether every file in `package` is linked into $HOME. Asks stow rather than
// comparing paths: where a directory like ~/.config/nvim already existed, stow
// links each entry inside it instead of the directory itself.
pub fun is_stowed(package: Text): Bool {
    const dir = dotfiles()
    const output = trust $ stow -n -v -d "{dir}" -t ~ -S "{package}" 2>&1 $
    return nothing_to_stow(output)
}

// A fresh directory to move replaced files into.
pub fun new_backup_dir(): Text {
    const stamp = trust $ date +%Y%m%d-%H%M%S $
    return "{home()}/.local/state/rcfiles/backup/{stamp}"
}

// Moves each target out of $HOME into `backup`, keeping its path.
pub fun back_up(targets: [Text], backup: Text): Null? {
    const base = home()
    for target in targets {
        const parent = trust $ dirname "{backup}/{target}" $
        dir_create(parent)?
        $ mv "{base}/{target}" "{backup}/{target}" $?
    }
}

// Adopts whole directories from unfolded_dirs: copies each over its place in
// `package`, then moves it to `backup` so stow can link the directory.
pub fun adopt_dirs(package: Text, dirs: [Text], backup: Text): Null? {
    const base = home()
    const repo = dotfiles()
    for dir in dirs {
        $ cp -R "{base}/{dir}/." "{repo}/{package}/{dir}/" $?
    }
    back_up(dirs, backup)?
}

// --adopt only takes plain files, so swap each symlinked target for a copy of
// what it points at (the link itself goes to `backup`).
pub fun dereference(targets: [Text], backup: Text): Null? {
    const base = home()
    for target in targets {
        trust $ test -L "{base}/{target}" $
        if status() == 0 {
            back_up([target], backup)?
            trust $ cp -RL "{backup}/{target}" "{base}/{target}" $
        }
    }
}
