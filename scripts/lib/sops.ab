// This machine's age key, and .sops.yaml: the list of keys every secret is
// encrypted to. Not executable, so mise doesn't list it as a task.

import { env_var_get } from "std/env"
import { split_lines, join, trim, starts_with, ends_with, slice, count_chars, match_regex } from "std/text"
import { xdg_config_home } from "./paths.ab"

// Where sops looks for age keys: $SOPS_AGE_KEY_FILE, else
// ${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt.
pub fun keys_path_from(sops_key_file: Text, config_home: Text): Text {
    if sops_key_file != "" {
        return sops_key_file
    }
    return "{config_home}/sops/age/keys.txt"
}

pub fun keys_path(): Text {
    return keys_path_from(trust env_var_get("SOPS_AGE_KEY_FILE"), xdg_config_home())
}

// Creates the key file when it is missing or empty.
pub fun ensure_machine_key(keys: Text): Null? {
    trust $ test -s "{keys}" $
    if status() != 0 {
        echo("Creating this machine's age key in {keys}")
        $ mkdir -p "\$(dirname "{keys}")" $?
        $ age-keygen -o "{keys}" 2>/dev/null $?
        $ chmod 600 "{keys}" $?
    }
}

pub fun machine_public_key(keys: Text): Text? {
    return $ age-keygen -y "{keys}" | head -n 1 $?
}

// Secrets are files named *.sops.<ext>, the same rule as in .sops.yaml.
pub fun is_secret_file(path: Text): Bool {
    return match_regex(path, "[^/]\.sops\.(json|ya?ml|env|ini)$", true)
}

// Tracked and untracked (but not ignored) secret files, relative to the repo.
pub fun secret_files(repo: Text): [Text] {
    let found = [Text]
    const listed = trust $ git -C "{repo}" ls-files --cached --others --exclude-standard $
    for path in split_lines(listed) {
        if is_secret_file(path) {
            found += [path]
        }
    }
    return found
}

// .sops.yaml as the first run writes it, with only the master key.
pub fun initial_rules(master: Text): Text {
    return join([
        "# Secrets committed to this repo are files named *.sops.<ext>, encrypted to",
        "# every key below. scripts/sops-bootstrap.ab (run by `mise run install`)",
        "# maintains this file: it adds each new machine, using the master key in",
        "# .sops-master.key.age, which the master password unlocks.",
        "#",
        "# Recipients:",
        "#   {master}  master",
        "creation_rules:",
        "  - path_regex: \\.sops\\.(json|ya?ml|env|ini)$",
        "    age: >-",
        "      {master}",
    ], "\n")
}

// A line that is only indentation and an age key with no comma after it: the
// last recipient, which is always the master key.
fun is_last_recipient(line: Text): Bool {
    const key = trim(line)
    return starts_with(key, "age1") and not ends_with(key, ",")
}

// Adds `key` to the rules: a comment line under "# Recipients:", and a
// recipient just above the master key so the master stays last and every
// other recipient ends in a comma.
pub fun add_recipient(rules: Text, key: Text, label: Text): Text {
    let out = [Text]
    for line in split_lines(rules) {
        if is_last_recipient(line) {
            const indent = slice(line, 0, count_chars(line) - count_chars(trim(line)))
            out += ["{indent}{key},"]
        }
        out += [line]
        if line == "# Recipients:" {
            out += ["#   {key}  {label}"]
        }
    }
    return join(out, "\n")
}
