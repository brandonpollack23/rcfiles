import { assert, assert_eq } from "std/test"
import { nothing_to_stow, stow_conflicts } from "../stow.ab"

test "stow_conflicts reads the targets out of stow's warnings" {
    const output = "WARNING! stowing starship would cause conflicts:
  * cannot stow src/r/dotfiles/starship/.config/starship.toml over existing target .config/starship.toml since neither a link nor a directory and --adopt not specified
  * existing target is not owned by stow: .zshrc
All operations aborted."
    const found = stow_conflicts(output)
    const n = len(found)
    assert_eq(n, 2)?
    assert_eq(found[0], ".config/starship.toml")?
    assert_eq(found[1], ".zshrc")?
}

test "stow_conflicts finds nothing in a clean dry run" {
    const found = stow_conflicts("LINK: .tmux.conf => src/r/dotfiles/tmux/.tmux.conf")
    const n = len(found)
    assert_eq(n, 0)?
}

test "nothing_to_stow holds for a dry run over a package that's already linked" {
    assert(nothing_to_stow("WARNING: in simulation mode so not modifying filesystem."))?
}

test "nothing_to_stow fails when something is left to link" {
    assert(not nothing_to_stow("LINK: .config/nvim/init.lua => ../src/r/dotfiles/nvim/.config/nvim/init.lua
WARNING: in simulation mode so not modifying filesystem."))?
}

test "nothing_to_stow fails when something is in the way" {
    assert(not nothing_to_stow("WARNING! stowing nvim would cause conflicts:
  * existing target is not owned by stow: .config/nvim
All operations aborted."))?
}
