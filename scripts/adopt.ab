#!/usr/bin/env -S sh -c 'exec amber run --target bash-3.2 "$0" -- "$@"'
//MISE description="Stow a package over existing files in $HOME, moving them into the repo (review with `jj diff` after)"
//USAGE arg "<package>..." var=#true

import { usage_words } from "./lib/run.ab"
import { conflicts_for, dereference, ensure_shared_dirs, new_backup_dir, stow } from "./lib/stow.ab"

main {
    ensure_shared_dirs()?
    const packages = usage_words("usage_package")
    const backup = new_backup_dir()
    for package in packages {
        dereference(conflicts_for(package), backup)?
    }
    stow("--adopt", packages)?
    echo("Adopted. The repo now has the files that were in $HOME; review them with 'jj diff' and restore what you don't want.")
}
