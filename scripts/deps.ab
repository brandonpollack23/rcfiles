#!/usr/bin/env -S sh -c 'exec amber run --target bash-3.2 "$0" -- "$@"'
//MISE description="Install the programs in packages.toml (Homebrew, casks and the App Store on the Mac, pacman/AUR on Arch, Homebrew on Debian and Fedora, cargo binstall everywhere), Rust (rustup), Erlang and Elixir (mise)"
//USAGE flag "-n --dry-run" help="Print the install commands instead of running them"
//USAGE flag "-y --yes" help="Install without asking first"
//USAGE arg "[group]..." var=#true help="Groups from packages.toml to install besides core (and mac on the Mac), or all. Default: the ones picked last time, asking the first time"

import { env_var_get, is_command, echo_error, input_confirm } from "std/env"
import { file_exists, file_read, file_write } from "std/fs"
import { split, split_lines, join } from "std/text"
import { array_contains } from "std/array"

import { detect_os, is_omarchy, ensure_brew } from "./lib/os.ab"
import { repo_root, run, set_dry_run, is_dry_run, is_interactive, keep_sudo, usage_words } from "./lib/run.ab"
import { home, xdg_config_home, put_cargo_on_path } from "./lib/paths.ab"
import { all_groups, group_names, packages_for, names_for, field } from "./lib/packages.ab"

// Remembers `picked` for the next run (unless this one is a dry run).

// The optional groups to install: named on the command line, else the ones
// picked last time, else asked for. Saved either way, for next time.
fun pick_groups(os: Text, groups: [Text], saved: Text): [Text]? {
    const asked = usage_words("usage_group")
    if len(asked) > 0 {
        const picked = groups_from_args(asked, group_names(groups))
        save_groups(saved, picked)?
        return picked
    }
    if file_exists(saved) {
        return groups_from_file(saved)?
    }
    let picked = [Text]
    if is_interactive() {
        picked = ask_groups(os, groups)
    } else {
        echo("deps: installing core only; name more groups with: mise run deps <group>...")
    }
    save_groups(saved, picked)?
    return picked
}

// The groups named on the command line: "all" for every optional one, else
// each name checked against packages.toml.
fun groups_from_args(asked: [Text], names: [Text]): [Text] {
    if join(asked, " ") == "all" {
        return optional_groups(names)
    }
    for name in asked {
        if not array_contains(names, name) {
            echo_error("deps: no group {name} in packages.toml", 1)
        }
    }
    return asked
}

// Every group but the ones every machine gets.
fun optional_groups(names: [Text]): [Text] {
    let optional = [Text]
    for name in names {
        if name != "core" and name != "mac" {
            optional += [name]
        }
    }
    return optional
}

// The groups an earlier run saved, one per line.
fun groups_from_file(saved: Text): [Text]? {
    let picked = [Text]
    for name in split_lines(file_read(saved)?) {
        if name != "" {
            picked += [name]
        }
    }
    return picked
}

// Asks about each optional group ("name<TAB>description" lines).
fun ask_groups(os: Text, groups: [Text]): [Text] {
    let and_mac = ""
    if os == "mac" {
        and_mac = ", and mac on every Mac"
    }
    echo("core goes on every machine{and_mac}. Which of these should this one have?")
    let picked = [Text]
    for group in groups {
        const parts = split(group, "\t")
        const name = field(parts, 0)
        if name != "core" and name != "mac" {
            if input_confirm("  {name}: {field(parts, 1)}?") {
                picked += [name]
            }
        }
    }
    return picked
}

fun save_groups(saved: Text, picked: [Text]): Null? {
    if is_dry_run() {
        return null
    }
    $ mkdir -p "\$(dirname "{saved}")" $?
    file_write(saved, join(picked, "\n"))?
    echo("deps: saved the groups in {saved}")
}

// `packages` without the ones already installed, saying which those are, so a
// rerun (after a failed install, say) doesn't reinstall or upgrade them. On
// Arch pacman decides, so a package that provides the name counts too (Omarchy's
// openai-codex-bin for openai-codex, neovim-nightly-bin for neovim); packages.toml's
// `bin` catches ones installed outside any package manager.
fun without_installed(packages: [Text]): [Text] {
    const pacman_missing = missing_from_pacman(names_for(packages, "pacman"))
    const formulae = brew_installed("--formula")
    const casks = brew_installed("--cask")
    const crates = cargo_installed()
    const apps = mas_installed()
    let kept = [Text]
    let skipped = [Text]
    for package in packages {
        const f = split(package, "|")
        const manager = field(f, 0)
        const name = field(f, 1)
        let installed = false
        if {
            manager == "installed" {
                installed = true
            }
            manager == "pacman" {
                installed = not array_contains(pacman_missing, name)
            }
            manager == "brew" {
                installed = array_contains(formulae, last_part(name))
            }
            manager == "cask" {
                installed = array_contains(casks, name)
            }
            manager == "cargo" {
                installed = array_contains(crates, name)
            }
            manager == "mas" {
                installed = array_contains(apps, name)
            }
            manager == "mise" {
                trust $ mise where {name} >/dev/null 2>&1 $
                installed = status() == 0
            }
        }
        if installed {
            skipped += [name]
        } else {
            kept += [package]
        }
    }
    if len(skipped) > 0 {
        echo("deps: already installed: {join(skipped, " ")}")
    }
    return kept
}

// The names pacman has nothing installed for (by name or by what it provides).
fun missing_from_pacman(names: [Text]): [Text] {
    if len(names) == 0 or not is_command("pacman") {
        return names
    }
    const listed = trust $ eval "pacman -T {join(names, " ")}" $
    let missing = [Text]
    for name in split_lines(listed) {
        if name != "" {
            missing += [name]
        }
    }
    return missing
}

// Installed formulae or casks (`kind` is --formula or --cask), by bare name.
fun brew_installed(kind: Text): [Text] {
    if not is_command("brew") {
        return [Text]
    }
    return split_lines(trust $ brew list -1 {kind} 2>/dev/null $)
}

// The crates cargo install (or binstall) put in ~/.cargo/bin.
fun cargo_installed(): [Text] {
    if not is_command("cargo") {
        return [Text]
    }
    return split_lines(trust $ cargo install --list 2>/dev/null | awk '/^[^ ]/ \{ print \$1 }' $)
}

// The App Store apps mas installed (or knows about), by id.
fun mas_installed(): [Text] {
    if not is_command("mas") {
        return [Text]
    }
    return split_lines(trust $ mas list 2>/dev/null | awk '\{ print \$1 }' $)
}

// "tap/formula" names are listed by the formula alone.
fun last_part(name: Text): Text {
    const parts = split(name, "/")
    const count = len(parts)
    return parts[count - 1]
}

// Lists what's about to be installed and asks once (unless -y, or there's no
// terminal to ask on); every installer after this runs without asking. Then
// takes the sudo password, so that comes now too and not mid-install.
fun confirm_install(packages: [Text]): Null? {
    if len(packages) == 0 {
        echo("deps: everything is installed already")
        return null
    }
    echo("deps: about to install")
    for manager in ["pacman", "brew", "cask", "mas", "cargo", "mise"] {
        const names = names_for(packages, manager)
        if len(names) > 0 {
            echo("  {manager}: {join(names, " ")}")
        }
    }
    const yes = trust env_var_get("usage_yes") == "true"
    if not yes and is_interactive() {
        if not input_confirm("Install these?") {
            echo_error("deps: nothing installed", 1)
        }
    }
    keep_sudo()?
}

fun mac_deps(packages: [Text]): Null? {
    brew_deps(packages)?
    const casks = names_for(packages, "cask")
    if len(casks) > 0 {
        run("brew install --cask {join(casks, " ")}")?
    }
    const apps = names_for(packages, "mas")
    if len(apps) > 0 {
        run("mas install {join(apps, " ")}")?
    }
}

fun arch_deps(packages: [Text]): Null? {
    const names = names_for(packages, "pacman")
    if len(names) == 0 {
        return null
    }
    // yay -S is fine on Omarchy; only a system upgrade has to go through
    // `omarchy update` (it snapshots, migrates and updates configs, and
    // Omarchy blocks a plain -Syu). Update first so what yay installs matches
    // the rest of the system; -y because confirm_install already asked.
    if is_omarchy() {
        run("omarchy update -y")?
    }
    if not is_command("yay") and not is_command("paru") {
        if is_dry_run() {
            echo("install_yay")
        } else {
            install_yay()?
        }
    }
    // confirm_install already asked, so neither helper should: no PKGBUILD
    // review (clean-build, diff or edit questions), and pacman takes its defaults.
    let aur_helper = "yay --noconfirm --answerclean None --answerdiff None --answeredit None"
    if not is_command("yay") {
        aur_helper = "paru --noconfirm --skipreview"
    }
    run("{aur_helper} -S --needed {join(names, " ")}")?
}

// Debian and Fedora: just what Homebrew needs from the system, then everything
// else from Homebrew; their own repos lack or lag many of these (jj, starship,
// sops, difftastic, lazygit...).
fun debian_deps(packages: [Text]): Null? {
    let missing = [Text]
    for name in ["build-essential", "procps", "curl", "file", "git"] {
        trust $ dpkg-query -W -f='\$\{Status}' {name} 2>/dev/null | grep -q "install ok installed" $
        if status() != 0 {
            missing += [name]
        }
    }
    if len(missing) > 0 {
        run("sudo apt-get update")?
        run("sudo apt-get install -y {join(missing, " ")}")?
    }
    brew_deps(packages)?
}

fun fedora_deps(packages: [Text]): Null? {
    // dnf5 lists the group by its id (development-tools), dnf4 by its name.
    trust $ dnf group list --installed 2>/dev/null | grep -Eqi '^ *development[- ]tools( |\$)' $
    if status() != 0 {
        run("sudo dnf group install -y development-tools")?
    }
    let missing = [Text]
    for name in ["procps-ng", "curl", "file", "git"] {
        trust $ rpm -q {name} >/dev/null 2>&1 $
        if status() != 0 {
            missing += [name]
        }
    }
    if len(missing) > 0 {
        run("sudo dnf install -y {join(missing, " ")}")?
    }
    brew_deps(packages)?
}

// Homebrew, and the formulae (on the Mac, Debian and Fedora).
fun brew_deps(packages: [Text]): Null? {
    if is_dry_run() {
        echo("ensure_brew")
    } else {
        ensure_brew()?
    }
    const formulae = names_for(packages, "brew")
    if len(formulae) > 0 {
        run("brew install {join(formulae, " ")}")?
    }
}

// yay isn't in the official repos, so build yay-bin from the AUR.
fun install_yay(): Null? {
    $ sudo pacman -S --needed --noconfirm git base-devel $?
    const build = $ mktemp -d $?
    $ git clone https://aur.archlinux.org/yay-bin.git "{build}/yay-bin" $?
    $ (cd "{build}/yay-bin" && makepkg -si --noconfirm) $?
    $ rm -rf "{build}" $?
}

// Rust, through rustup (its own installer, unless a package manager already
// put rustup there, like Arch's dev group). Crates go in ~/.cargo/bin, which
// .zshrc puts on PATH too.
fun ensure_rust(): Null? {
    const base = home()
    if not file_exists("{base}/.cargo/bin/rustup") and not is_command("rustup") {
        $ curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path $?
    }
    put_cargo_on_path()
    trust $ rustup default >/dev/null 2>&1 $
    if status() != 0 {
        $ rustup default stable $?
    }
}

// binstall asks the GitHub API for release assets, and without a token it gets
// 60 requests an hour, which a handful of crates uses up. It only finds gh's
// token in hosts.yml, and gh keeps it in the keyring, so export it here. On a
// fresh machine gh isn't logged in yet (setup does that, after deps), so log
// in now if there's a terminal to do it on.
fun export_github_token(): Null {
    const have = trust env_var_get("GITHUB_TOKEN") + trust env_var_get("GH_TOKEN")
    if have != "" or not is_command("gh") {
        return null
    }
    trust $ gh auth status >/dev/null 2>&1 $
    if status() != 0 {
        if not is_interactive() {
            echo("deps: gh is not logged in, so cargo binstall may be rate limited by GitHub")
            return null
        }
        echo("deps: log in to GitHub so cargo binstall isn't rate limited")
        trust $ gh auth login $
    }
    const token = trust $ gh auth token 2>/dev/null $
    if token != "" {
        trust $ export GITHUB_TOKEN="{token}" $
    }
}

// mise only has prebuilt Erlang for the Mac and Ubuntu; anywhere else it falls
// back to building with kerl, which fails ("autoconf: no input file"). Bob's
// Ubuntu 24.04 builds run on Arch, Debian and Fedora too (they need glibc,
// OpenSSL 3 and ncurses 6). Never build: fail instead, so it's noticed.
// These go in ~/.config/mise/config.toml, so `mise up` keeps using them.
fun prebuilt_erlang(os: Text): Null? {
    if os != "mac" {
        run("mise settings set erlang.precompiled_os ubuntu-24.04")?
    }
    run("mise settings set erlang.compile false")?
}

main {
    set_dry_run(trust env_var_get("usage_dry_run") == "true")
    const root = repo_root()
    const os = detect_os()
    const saved = "{xdg_config_home()}/rcfiles/groups"

    const groups = all_groups(root)?
    const picked = pick_groups(os, groups, saved)?
    let installing = ["core"]
    if os == "mac" {
        installing += ["mac"]
    }
    installing += picked
    echo("deps: installing {join(installing, " ")}")
    // Erlang and Elixir come from mise, whatever the OS.
    const beam = ["mise|erlang", "mise|elixir"]
    const packages = without_installed(packages_for(root, os, installing)? + beam)
    if not is_dry_run() {
        confirm_install(packages)?
    }

    if {
        os == "mac" {
            mac_deps(packages)?
        }
        os == "arch" {
            arch_deps(packages)?
        }
        os == "debian" {
            debian_deps(packages)?
        }
        os == "fedora" {
            fedora_deps(packages)?
        }
        else {
            echo_error("deps: not supported on {os}", 1)
        }
    }

    if not is_dry_run() {
        ensure_rust()?
    }
    const crates = names_for(packages, "cargo")
    if len(crates) > 0 {
        if not is_dry_run() {
            export_github_token()
        }
        run("cargo binstall -y {join(crates, " ")}")?
    }

    // Erlang and Elixir: the latest stable releases, pinned in ~/.config/mise/config.toml.
    let tools = [Text]
    for tool in names_for(packages, "mise") {
        tools += ["{tool}@latest"]
    }
    if len(tools) > 0 {
        prebuilt_erlang(os)?
        run("mise use -g {join(tools, " ")}")?
    }
}
