import { assert, assert_eq } from "std/test"
import { set_alias, has, LS_NAMES, LS_VALUES, APT_NAMES, APT_VALUES, PAMAC_NAMES, PAMAC_VALUES } from "../src/aliases.ab"
import { path_prepend, path_append } from "../src/paths.ab"

test "every alias name has a value" {
    assert(len(LS_NAMES) == len(LS_VALUES))?
    assert(len(APT_NAMES) == len(APT_VALUES))?
    assert(len(PAMAC_NAMES) == len(PAMAC_VALUES))?
}

test "set_alias stores the value unexpanded" {
    set_alias("rc_test_alias", "sudo $(fc -ln -1) \"$HOME\"")
    const shown = trust $ alias rc_test_alias $
    assert_eq(shown, "rc_test_alias='sudo $(fc -ln -1) \"$HOME\"'")?
}

test "has sees commands and rejects unknown names" {
    assert(has("printf"))?
    assert(not has("surely-not-a-command-rc-test"))?
}

test "path helpers skip missing directories" {
    trust $ export PATH="/usr/bin:/bin" $
    path_prepend("/surely/not/a/dir")
    path_append("/surely/not/a/dir/either")
    const unchanged = trust $ printf '%s' "\$PATH" $
    assert_eq(unchanged, "/usr/bin:/bin")?
    path_prepend("/")
    path_append("/tmp")
    const changed = trust $ printf '%s' "\$PATH" $
    assert_eq(changed, "/:/usr/bin:/bin:/tmp")?
}
