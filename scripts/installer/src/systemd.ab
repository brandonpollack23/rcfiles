// systemd units the desktop relies on.

import { is_command } from "std/env"
import { run, as_root, note_problem } from "./run.ab"

fun unit_exists(unit: Text, user: Bool): Bool {
    let scope = ""
    if user {
        scope = "--user "
    }
    $ systemctl {scope}cat {unit} >/dev/null 2>&1 $ failed {
        return false
    }
    return true
}

pub fun setup_systemd(): Null {
    if not is_command("systemctl") {
        return null
    }
    // Pick up the user units link_systemd_units just linked.
    run("systemctl --user daemon-reload") failed {
        note_problem("systemctl --user daemon-reload failed")
    }
    // Hyprland starts swaync itself; stop D-Bus activating a second copy.
    run("systemctl --user mask swaync.service") failed {
        note_problem("could not mask swaync.service")
    }
    // ydotoold sends the notification center's vim keys (.config/hypr/conf/notifications.lua).
    if unit_exists("ydotool.service", true) {
        run("systemctl --user enable --now ydotool.service") failed {
            note_problem("could not enable ydotool.service")
        }
    }
    // SwayOSD's key listener is a system service (it reads /dev/input as
    // root); swayosd-server itself is started by Hyprland.
    if unit_exists("swayosd-libinput-backend.service", false) {
        run(as_root("systemctl enable --now swayosd-libinput-backend.service")) failed {
            note_problem("could not enable swayosd-libinput-backend.service")
        }
    }
}
