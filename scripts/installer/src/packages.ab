pub const DEBIAN = [
    "default-jdk",            // OpenJDK; jdk-openjdk on Arch
    "fd-find",                // find replacement, installed as fdfind; fd on Arch
    "firefox-esr",            // firefox on Arch
    "pandoc",                 // Document converter; pandoc-cli on Arch
    "sqlite3",                // SQLite shell; sqlite on Arch

    "apt-file",               // Which package has a file
    "debian-handbook",        // Debian administration guide
    "devscripts",             // Debian packaging scripts
    "etherwake",              // Wake-on-LAN packets
    "fortunes-debian-hints",  // Debian fortune cookies
    "info",                   // Info documents
    "libgraphicsmagick1-dev", // GraphicsMagick headers
    "libmagickwand-dev",      // ImageMagick Wand headers
    "net-tools",              // ifconfig, netstat
    "texinfo",                // GNU documentation system
    "wakeonlan",              // Wake-on-LAN packets
]
