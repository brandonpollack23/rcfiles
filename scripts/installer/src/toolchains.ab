// Language toolchains: mise for most, cargo for Rust tools, mix for Elixir.
// Each step reports a failure and carries on, like the package installs.

import { env_var_get, is_command } from "std/env"
import { file_exists, dir_exists } from "std/fs"
import { run, step, as_root, heading, quoted, note_problem, is_dry_run } from "./run.ab"

// `mise use -g`, one line per tool so a bad version only loses that tool.
pub const MISE_GLOBALS = [
    "node@latest",
    "deno@latest",
    "bun@latest",
    "pnpm@latest",
    "yarn@latest",
    "go@latest",
    "uv@latest",
    "erlang@28.0.2",
    "elixir@1.18.4-otp-28",
]

// cargo binstall downloads prebuilt binaries where it can.
pub const CARGO_BINSTALL = ["mdcat", "bat", "git-delta", "tree-sitter-cli"]

// Installed through cargo only when the system has no such program, e.g. on
// Debian, where these are not packaged.
pub const CARGO_IF_MISSING_CRATES = ["fd-find", "git-branchless"]
pub const CARGO_IF_MISSING_BINARIES = ["fd", "git-branchless"]

pub const MIX_ARCHIVES = [
    "mix archive.install hex mix_templates",
    "mix archive.install hex mix_generator",
    "mix template.install hex gen_template_template",
    "mix template.install hex bpollack_elixir_template",
]

fun install_mise_tools(): Null {
    if not is_command("mise") {
        note_problem("mise is not installed; skipped the mise tools")
        return null
    }
    for tool in MISE_GLOBALS {
        step("mise use -g {tool}", "mise use -g {tool}")
    }
}

fun install_nix(): Null {
    // The installer refuses to run over an existing /nix.
    if is_command("nix") or dir_exists("/nix") {
        echo("nix is already installed")
        return null
    }
    step("nix install", as_root("sh <(curl -L https://nixos.org/nix/install) --daemon"))
}

fun install_rust_tools(home: Text): Null {
    // rustup installs no toolchain by itself; cargo fails until there is one.
    if is_command("rustup") {
        $ rustup show active-toolchain >/dev/null 2>&1 $ failed {
            step("rustup default stable", "rustup default stable")
        }
    }
    if file_exists("{home}/.cargo/env") {
        run(". {quoted("{home}/.cargo/env")}") failed {
            note_problem("could not source {home}/.cargo/env")
        }
    }
    if not is_command("cargo") and not is_dry_run() {
        note_problem("cargo is not installed; skipped the Rust tools")
        return null
    }
    if not is_command("cargo-binstall") {
        step("cargo-binstall", "cargo install cargo-binstall")
    }
    if not is_command("cargo-outdated") {
        step("cargo-outdated", "cargo install --locked cargo-outdated")
    }
    for crate in CARGO_BINSTALL {
        step("cargo binstall {crate}", "cargo binstall --no-confirm {crate}")
    }
    for i, crate in CARGO_IF_MISSING_CRATES {
        if not is_command(CARGO_IF_MISSING_BINARIES[i]) {
            step("cargo binstall {crate}", "cargo binstall --no-confirm {crate}")
        }
    }
    if not is_command("neovide") {
        step("neovide", "cargo install --git https://github.com/neovide/neovide")
    }
}

fun install_elixir_tools(): Null {
    if not is_command("mix") and not is_dry_run() {
        note_problem("mix is not on PATH; skipped the Elixir tools")
        return null
    }
    for archive in MIX_ARCHIVES {
        step(archive, "yes | {archive}")
    }
    step("rebar and hex", "mix do local.rebar --force, local.hex --force")
    step("livebook", "mix escript.install --force hex livebook")
}

pub fun install_toolchains(home: Text): Null {
    heading("Toolchains (mise)")
    install_mise_tools()
    heading("Nix")
    install_nix()
    heading("Rust tools")
    install_rust_tools(home)
    heading("Elixir tools")
    // mise's shims put mix on PATH for this run.
    trust run("export PATH={quoted("{home}/.local/share/mise/shims")}:\"$PATH\"")
    install_elixir_tools()
}
