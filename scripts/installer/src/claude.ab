// Claude Code settings: the tracked layer in the repo, the local one in $HOME.

import { file_exists } from "std/fs"
import { run, quoted, note_problem } from "./run.ab"
import { link, is_symlink } from "./links.ab"

// The fields of ~/.claude/settings.json that are this machine's own.
pub const LOCAL_FIELDS = "\{model, modelSettings, skipAutoPermissionPrompt, hooks, autoMode} | with_entries(select(.value != null))"

// Claude Code writes the selected model and other machine state to
// ~/.claude/settings.json, so that file stays local and the tracked settings
// are linked beside it as settings.shared.json (the claude alias loads them).
// An old install linked settings.json itself into the repo: that link becomes
// a local file holding only the local fields.
pub fun setup_claude(rc_dir: Text, home: Text): Null {
    const shared = "{rc_dir}/.claude/settings.json"
    const local_settings = "{home}/.claude/settings.json"

    const is_link = is_symlink(local_settings)
    const target = trust $ realpath "{local_settings}" 2>/dev/null $
    const tmp = quoted("{local_settings}.tmp")
    if {
        is_link and target == shared {
            run("jq {quoted(LOCAL_FIELDS)} {quoted(local_settings)} >{tmp} && mv -f {tmp} {quoted(local_settings)}") failed {
                note_problem("could not migrate {local_settings}")
            }
        }
        not file_exists(local_settings) and not is_link {
            run("mkdir -p {quoted("{home}/.claude")} && printf '\{}\\n' >{quoted(local_settings)}") failed {
                note_problem("could not create {local_settings}")
            }
        }
    }
    link(shared, "{home}/.claude/settings.shared.json")
}
