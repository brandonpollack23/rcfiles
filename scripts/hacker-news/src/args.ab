// Command-line and environment settings.

import { env_var_get } from "std/env"
import { parse_int } from "std/text"

pub const DEFAULT_MAX_AGE = 18000 // 5 hours
pub const DEFAULT_COUNT = 30

// The value after `flag` in args, or "" when the flag is absent or last.
pub fun flag_value(args: [Text], flag: Text): Text {
    for i, arg in args {
        if arg == flag and i + 1 < len(args) {
            return args[i + 1]
        }
    }
    return ""
}

pub fun has_flag(args: [Text], flag: Text): Bool {
    for arg in args {
        if arg == flag {
            return true
        }
    }
    return false
}

// The first non-empty of the flag value, the environment variable, and the
// default. A value that is not a whole number falls through to the next one.
pub fun int_setting(args: [Text], flag: Text, env: Text, default: Int): Int {
    const from_flag = flag_value(args, flag)
    if from_flag != "" {
        const n = parse_int(from_flag) failed {
            return default
        }
        return n
    }
    const from_env = trust env_var_get(env)
    if from_env != "" {
        const n = parse_int(from_env) failed {
            return default
        }
        return n
    }
    return default
}
