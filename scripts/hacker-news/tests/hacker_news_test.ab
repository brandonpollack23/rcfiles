import { assert, assert_eq } from "std/test"
import { text_contains } from "std/text"
import { flag_value, has_flag, int_setting, DEFAULT_COUNT } from "../src/args.ab"
import { is_stale, lock_path } from "../src/cache.ab"
import { strip_html, snippet, json_field, entry_json, SNIPPET_LENGTH } from "../src/fetch.ab"
import { motd, story_field, random_story } from "../src/render.ab"
import { count_chars } from "std/text"

test "flag_value reads the argument after a flag" {
    const args = ["hacker-news.sh", "--count", "5", "--max-age", "60"]
    assert_eq(flag_value(args, "--count"), "5")?
    assert_eq(flag_value(args, "--max-age"), "60")?
    assert_eq(flag_value(args, "--missing"), "")?
    assert_eq(flag_value(["x", "--count"], "--count"), "")?
}

test "has_flag" {
    assert(has_flag(["x", "--refresh"], "--refresh"))?
    assert(not has_flag(["x", "--count", "3"], "--refresh"))?
}

test "int_setting prefers the flag and falls back on bad input" {
    assert_eq(int_setting(["x", "--count", "7"], "--count", "HN_TEST_UNSET", 30), 7)?
    assert_eq(int_setting(["x"], "--count", "HN_TEST_UNSET", 30), 30)?
    assert_eq(int_setting(["x", "--count", "lots"], "--count", "HN_TEST_UNSET", 30), 30)?
    assert_eq(DEFAULT_COUNT, 30)?
}

test "is_stale is strictly older than max age" {
    assert(not is_stale(100, 100))?
    assert(is_stale(101, 100))?
    assert(not is_stale(0, 18000))?
}

test "lock sits next to the cache" {
    assert_eq(lock_path("/tmp/hn"), "/tmp/hn.lock")?
}

test "strip_html drops tags and decodes entities" {
    assert_eq(strip_html("<p>It&#x27;s &quot;fine&quot; &amp; ok</p>"), " It's \"fine\" & ok ")?
    assert_eq(strip_html("a&gt;b&lt;c &#x2F;path"), "a>b<c /path")?
}

test "snippet trims and truncates" {
    assert_eq(snippet("<p>  hello  </p>"), "hello")?
    let long = ""
    for i in 0..30 {
        long += "word "
    }
    assert_eq(count_chars(snippet(long)), SNIPPET_LENGTH)?
}

test "entry_json round-trips awkward text" {
    const entry = entry_json("A \"quoted\" $title", "https://x.test/?a=1&b=2", "it's")
    assert_eq(json_field(entry, "title"), "A \"quoted\" $title")?
    assert_eq(json_field(entry, "url"), "https://x.test/?a=1&b=2")?
    assert_eq(json_field(entry, "comment"), "it's")?
    assert_eq(json_field(entry, "missing"), "")?
}

test "motd leaves out empty lines" {
    const full = motd("Title", "https://x.test", "a comment")
    assert(text_contains(full, "Title"))?
    assert(text_contains(full, "https://x.test"))?
    assert(text_contains(full, "a comment"))?
    const bare = motd("Title", "", "")
    assert(not text_contains(bare, "💬"))?
    assert(not text_contains(bare, "   http"))?
}

test "story_field reads each prefixed line, empty ones too" {
    const story = "TA title\nU\nCa comment"
    assert_eq(story_field(story, "T"), "A title")?
    assert_eq(story_field(story, "U"), "")?
    assert_eq(story_field(story, "C"), "a comment")?
}

test "random_story reads the cache and survives an empty one" {
    const dir = trust $ mktemp -d $
    trust $ printf '%s' '[\{"title":"Only","url":"","comment":"c"}]' >"{dir}/one" $
    trust $ printf '%s' '[]' >"{dir}/empty" $
    const story = random_story("{dir}/one")
    assert_eq(story_field(story, "T"), "Only")?
    assert_eq(story_field(story, "C"), "c")?
    assert_eq(random_story("{dir}/empty"), "")?
    assert_eq(random_story("{dir}/missing"), "")?
    trust $ rm -rf "{dir}" $
}
