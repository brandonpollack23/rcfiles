#!/usr/bin/env bash
#MISE description="Let this machine decrypt the secrets (asks for the master password)"
# Lets this machine decrypt the repo's secrets (*.sops.*, rules in .sops.yaml).
# Run by `mise run install`; safe to run again, it only does what is still missing.
#
# Every machine has its own age key in ~/.config/sops/age/keys.txt and is a
# recipient in .sops.yaml. What lets a new machine in is the master key: an age
# key that is also a recipient, committed as .sops-master.key.age, encrypted
# with a passphrase (the master password). So, on a new machine:
#
#   1. make this machine's key, if it has none
#   2. add its public key to .sops.yaml
#   3. ask for the master password, and with the master key re-encrypt every
#      secret to the new list of recipients (`sops updatekeys`)
#
# after which the master key is not needed here again. Commit and push what
# changed (.sops.yaml and the secrets), or the next machine undoes it.
#
# The first run anywhere creates the master key and asks for a new password.

set -euo pipefail

REPO=$(dirname "$(dirname "$(readlink -f "$0")")")
RULES="$REPO/.sops.yaml"
MASTER="$REPO/.sops-master.key.age"
KEYS="${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}"

for tool in sops age age-keygen; do
  command -v "$tool" >/dev/null || { echo "sops-bootstrap: $tool is not installed, skipping" >&2; exit 0; }
done

secrets() {
  git -C "$REPO" ls-files --cached --others --exclude-standard | grep -E '[^/]\.sops\.(json|ya?ml|env|ini)$' || true
}

# Inserted above the master key, which stays last: every line but the last
# ends in a comma.
add_recipient() { # <public key> <label>
  sed -i "s|^# Recipients:\$|&\n#   $1  $2|; s|^\( *\)\(age1[a-z0-9]*\)\$|\1$1,\n\1\2|" "$RULES"
}

if ! test -s "$KEYS"; then
  echo "Creating this machine's age key in $KEYS"
  mkdir -p "$(dirname "$KEYS")"
  age-keygen -o "$KEYS" 2>/dev/null
  chmod 600 "$KEYS"
fi
machine=$(age-keygen -y "$KEYS" | head -n 1)

if ! test -f "$MASTER"; then
  echo "Creating the master key. Choose the master password: it is what adds new machines."
  key=$(age-keygen 2>/dev/null)
  master=$(age-keygen -y <<<"$key")
  age --passphrase --armor -o "$MASTER" <<<"$key"
  unset key
  cat >"$RULES" <<EOF
# Secrets committed to this repo are files named *.sops.<ext>, encrypted to
# every key below. sops-bootstrap.sh (run by "mise run install") maintains this file:
# it adds each new machine, using the master key in .sops-master.key.age, which
# the master password unlocks.
#
# Recipients:
#   $master  master
creation_rules:
  - path_regex: \.sops\.(json|ya?ml|env|ini)\$
    age: >-
      $master
EOF
  if secrets | grep -q .; then
    echo "The existing secrets are not encrypted to the new master key yet: this machine must be able to decrypt them."
    rekey_with_machine_key=1
  fi
fi

files=$(secrets)
if grep -q "$machine" "$RULES"; then
  test -n "${rekey_with_machine_key:-}" || { echo "sops: this machine can already decrypt the secrets"; exit 0; }
elif test -n "$files" && test -z "${rekey_with_machine_key:-}"; then
  # Before .sops.yaml changes, so a wrong password leaves nothing half done.
  # The master key only ever lives in this variable.
  echo "Adding this machine ($(uname -n)) to the repo's secrets. Master password:"
  SOPS_AGE_KEY=$(age --decrypt "$MASTER")
  export SOPS_AGE_KEY
fi
grep -q "$machine" "$RULES" || add_recipient "$machine" "$(uname -n)"

if test -z "$files"; then
  echo "sops: added this machine to .sops.yaml; there are no secrets to re-encrypt yet"
  exit 0
fi

while read -r file; do
  (cd "$REPO" && sops updatekeys --yes "$file")
done <<<"$files"
unset SOPS_AGE_KEY

echo "sops: done. Commit and push .sops.yaml and the re-encrypted secrets:"
echo "  git -C $REPO add .sops.yaml .sops-master.key.age $(tr '\n' ' ' <<<"$files")"
