#!/usr/bin/env -S sh -c 'exec amber run --target bash-3.2 "$0" -- "$@"'
//MISE description="Install zsh (antidote), tmux (tpm), neovim (lazy.nvim + Mason) and Omarchy shell plugins, asking first about neovim and Mason"
//MISE wait_for=["stow"]

import { dir_exists, file_read } from "std/fs"
import { split_words } from "std/text"
import { input_confirm, echo_error } from "std/env"
import { repo_root, is_interactive } from "./lib/run.ab"
import { home, xdg_config_home, xdg_data_home } from "./lib/paths.ab"
import { set_nvim_skipped } from "./lib/nvim.ab"
import { is_omarchy } from "./lib/os.ab"
import { lock_entries, is_lock_entry } from "./lib/omarchy_plugins.ab"

// Yes unless the answer is no; without a terminal to ask on, yes.
fun ask(prompt: Text): Bool {
    if not is_interactive() {
        return true
    }
    return input_confirm(prompt, true)
}

// Clones each plugin in plugins.lock that's missing, at its pinned commit,
// then has a running shell pick them up.
fun restore_omarchy_plugins(root: Text): Null? {
    const lockfile = "{root}/dotfiles/omarchy/.config/omarchy/plugins.lock"
    const dir = "{xdg_config_home()}/omarchy/plugins"
    for entry in lock_entries(file_read(lockfile)?) {
        if not is_lock_entry(entry) {
            echo_error("{lockfile}: want an id, a git URL and a commit, got: {entry}", 1)
        }
        const fields = split_words(entry)
        restore_omarchy_plugin("{dir}/{fields[0]}", fields[1], fields[2])?
    }
    trust $ omarchy-shell shell rescanPlugins >/dev/null 2>&1 $
}

// Clones `url` into `target` at `commit`, or fast-forwards a clean checkout
// that's behind it. One ahead of the lock or off it is left alone.
fun restore_omarchy_plugin(target: Text, url: Text, commit: Text): Null? {
    if not dir_exists(target) {
        $ git clone --quiet -- "{url}" "{target}" $?
        $ git -C "{target}" reset --quiet --hard "{commit}" $?
        return null
    }
    const head = $ git -C "{target}" rev-parse HEAD $?
    if head == commit {
        return null
    }
    $ git -C "{target}" fetch --quiet origin $?
    trust $ git -C "{target}" merge-base --is-ancestor HEAD "{commit}" $
    const behind = status() == 0
    const changes = $ git -C "{target}" status --porcelain $?
    if behind and changes == "" {
        $ git -C "{target}" merge --quiet --ff-only "{commit}" $?
        return null
    }
    echo("{target} is at {head}, not {commit} as plugins.lock has it; left as is.")
    echo("  To keep this version, put {head} in plugins.lock.")
}

main {
    const base = home()
    const root = repo_root()

    // Both questions up front, so the rest runs unattended. Whatever is
    // skipped here, neovim installs the first time it's opened.
    const nvim = ask("Set up neovim plugins now?")
    let mason = false
    if nvim {
        mason = ask("Install Mason's language servers and tools now?")
    }
    set_nvim_skipped(not nvim)?

    const antidote = "{xdg_data_home()}/antidote"
    if not dir_exists(antidote) {
        $ git clone --depth=1 https://github.com/mattmc3/antidote.git "{antidote}" $?
    }
    $ zsh -c "source {antidote}/antidote.zsh && antidote bundle <{base}/.zsh_plugins.txt >{base}/.zsh_plugins.zsh" $?

    const tpm = "{xdg_config_home()}/tmux/plugins/tpm"
    if not dir_exists(tpm) {
        $ git clone --depth=1 https://github.com/tmux-plugins/tpm "{tpm}" $?
    }
    $ "{tpm}/bin/install_plugins" $?

    if nvim {
        // Installs the versions pinned in lazy-lock.json.
        $ nvim --headless "+Lazy! restore" +qa $?
    }
    if mason {
        // Mason tools have no lockfile, so these install at the latest registry version.
        $ nvim --headless "+luafile {root}/scripts/lib/mason-install.lua" $?
    }

    if is_omarchy() {
        restore_omarchy_plugins(root)?
    }
}
