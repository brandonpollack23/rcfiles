#!/usr/bin/env -S amber run
// Checks, tests and compiles every Amber project under scripts/.
//
//   scripts/build.ab check     amber check each entry point (shows warnings)
//   scripts/build.ab test      amber test each project
//   scripts/build.ab build     compile each entry point to its committed output
//   scripts/build.ab outputs   print the generated paths, one per line
//   scripts/build.ab hooks     point this clone's git hooks at .githooks/
//
// Also exposed as `mise run check|test|build|hooks`. This file runs from source
// (it needs amber installed) and is never compiled; .githooks/pre-commit
// imports it. To add a project, add a row to each of the ENTRY_* arrays and to
// the PROJECT_* arrays below.

import { file_exists, dir_exists } from "std/fs"
import { echo_error, echo_success } from "std/env"
import { starts_with } from "std/text"
import { assert, assert_eq } from "std/test"

// One row per compiled entry point, paths relative to the repo root.
pub const ENTRY_SOURCES = [
    "scripts/installer/main.ab",
    "scripts/zshrc/env.ab",
    "scripts/zshrc/rc.ab",
    "scripts/hacker-news/main.ab",
    "scripts/sops/main.ab",
]
pub const ENTRY_OUTPUTS = [
    "scripts/installer/install.sh",
    "scripts/zshrc/build/env.zsh",
    "scripts/zshrc/build/rc.zsh",
    "scripts/hacker-news/hacker-news.sh",
    "scripts/sops/sops-bootstrap.sh",
]
pub const ENTRY_TARGETS = ["bash", "zsh", "zsh", "bash", "bash"]

// One row per project directory, for `amber test`.
pub const PROJECT_DIRS = [
    "scripts/installer",
    "scripts/zshrc",
    "scripts/hacker-news",
    "scripts/sops",
]
pub const PROJECT_TARGETS = ["bash", "zsh", "bash", "bash"]

// The repo root, from wherever inside it this runs (mise, the hook, a shell).
pub fun repo_root(): Text? {
    const root = $ git rev-parse --show-toplevel 2>/dev/null $ failed {
        echo_error("build.ab: run this from inside the rcfiles repo", 0)
        fail 1
    }
    return root
}

// `text` as one shell word.
fun quoted(text: Text): Text {
    return trust $ printf '%q' "{text}" $
}

// Runs one amber command line from the repo root, quietly, printing its output
// only when it fails. Paths stay relative: amber writes the source path into
// its generated error messages, and an absolute one would make every clone's
// build differ.
fun amber_quiet(root: Text, what: Text, cmd: Text): Null? {
    const log = "{root}/.git/amber-build.log"
    $ (cd "{root}" && eval "{cmd}") >"{log}" 2>&1 $ failed(code) {
        $ cat "{log}" >&2 $?
        trust $ rm -f "{log}" $
        echo_error("amber: {what} failed", 0)
        fail code
    }
    trust $ rm -f "{log}" $
}

pub fun check_all(): Null? {
    const root = repo_root()?
    for i, src in ENTRY_SOURCES {
        echo("check {src}")
        $ amber check --target {ENTRY_TARGETS[i]} "{root}/{src}" $ failed(code) {
            echo_error("amber: check {src} failed", 0)
            fail code
        }
    }
    $ amber check "{root}/scripts/build.ab" $?
    $ amber check "{root}/.githooks/pre-commit" $?
}

pub fun test_all(): Null? {
    const root = repo_root()?
    for i, dir in PROJECT_DIRS {
        amber_quiet(root, "test {dir}", "amber test --target {PROJECT_TARGETS[i]} {quoted(dir)}")?
    }
    amber_quiet(root, "test scripts/build.ab", "amber test scripts/build.ab")?
    echo_success("amber: all tests passed")
}

// The GENERATED line goes right after the shebang, which must stay line 1.
fun generated_line(src: Text): Text {
    return "# GENERATED from {src} by scripts/build.ab. Edit the .ab sources, then run: mise run build"
}

pub fun build_one(root: Text, src: Text, out: Text, target: Text): Null? {
    const tmp = "{root}/{out}.tmp"
    $ mkdir -p "\$(dirname "{root}/{out}")" $?
    amber_quiet(root, "build {src}", "amber build --target {target} {quoted(src)} {quoted("{out}.tmp")}")?
    $ sed -i "1a {generated_line(src)}" "{tmp}" $?
    if target == "bash" {
        $ chmod +x "{tmp}" $?
    }
    $ mv -f "{tmp}" "{root}/{out}" $?
}

pub fun build_all(): Null? {
    const root = repo_root()?
    for i, src in ENTRY_SOURCES {
        build_one(root, src, ENTRY_OUTPUTS[i], ENTRY_TARGETS[i])?
        echo("built {ENTRY_OUTPUTS[i]}")
    }
}

// Stages the outputs; the pre-commit hook calls this after build_all.
pub fun stage_outputs(): Null? {
    const root = repo_root()?
    for out in ENTRY_OUTPUTS {
        $ git -C "{root}" add -- "{out}" $?
    }
}

pub fun install_hooks(): Null? {
    const root = repo_root()?
    $ git -C "{root}" config core.hooksPath .githooks $?
    echo_success("git hooks: {root}/.githooks")
}

fun usage(): Null {
    echo("usage: scripts/build.ab check|test|build|outputs|hooks")
}

main(args) {
    // Under `amber run`, args[0] is the shell, not this file.
    if len(args) < 2 {
        usage()
        exit(2)
    }
    const cmd = args[1]
    if {
        cmd == "check" { check_all()? }
        cmd == "test" { test_all()? }
        cmd == "build" { build_all()? }
        cmd == "outputs" { for out in ENTRY_OUTPUTS { echo(out) } }
        cmd == "hooks" { install_hooks()? }
        else {
            usage()
            exit(2)
        }
    }
}

test "every entry has a source, an output and a target" {
    assert(len(ENTRY_SOURCES) == len(ENTRY_OUTPUTS))?
    assert(len(ENTRY_SOURCES) == len(ENTRY_TARGETS))?
    assert(len(PROJECT_DIRS) == len(PROJECT_TARGETS))?
}

test "every listed source and project exists" {
    const root = trust repo_root()
    for src in ENTRY_SOURCES {
        assert(file_exists("{root}/{src}"))?
    }
    for dir in PROJECT_DIRS {
        assert(dir_exists("{root}/{dir}"))?
    }
}

test "every entry point lives in a listed project" {
    for src in ENTRY_SOURCES {
        let found = false
        for dir in PROJECT_DIRS {
            if starts_with(src, "{dir}/") {
                found = true
            }
        }
        assert(found)?
    }
}

test "targets are ones amber knows" {
    for t in ENTRY_TARGETS {
        assert(t == "bash" or t == "zsh")?
    }
}
