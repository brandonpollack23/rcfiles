#!/usr/bin/env -S sh -c 'exec amber run --target bash-3.2 "$0" -- "$@"'
//MISE description="Link packages into $HOME (all of them if none are named)"
//MISE wait_for=["deps"]
//USAGE arg "[package]..." var=#true help="Packages to link (default: all)"

import { usage_words } from "./lib/run.ab"
import { all_packages, ensure_shared_dirs, stow } from "./lib/stow.ab"

main {
    let packages = usage_words("usage_package")
    if len(packages) == 0 {
        packages = all_packages()
    }
    ensure_shared_dirs()?
    stow("-R", packages)?
}
