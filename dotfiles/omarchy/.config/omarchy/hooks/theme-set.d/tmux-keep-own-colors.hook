#!/bin/bash

# omarchy-theme-set always runs omarchy-theme-set-tmux, which has no opt-out.
# It sets tmux's window-style/cursor-colour to the theme and writes the
# theme's palette as OSC sequences into every pane. This hook runs after it and
# undoes both, so tmux shows ghostty's own `theme =` like everything else.

tmux list-sessions >/dev/null 2>&1 || exit 0

tmux set-option -gu window-style
tmux set-option -gu window-active-style
tmux set-option -gu cursor-colour

# Reset each pane's palette (104), foreground (110), background (111) and
# cursor (112) to the outer terminal's.
reset=$'\e]104\a\e]110\a\e]111\a\e]112\a'
while IFS= read -r pane_tty; do
  [[ $pane_tty == /dev/pts/* ]] || continue
  printf '%s' "$reset" >"$pane_tty" 2>/dev/null || true
done < <(tmux list-panes -a -F "#{pane_tty}" | sort -u)

while IFS= read -r client; do
  tmux refresh-client -t "$client" 2>/dev/null || true
done < <(tmux list-clients -F "#{client_name}")
