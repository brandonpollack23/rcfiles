{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "brandonpollack23.beautiful-workspace-bar",
          "previewSize": 320
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "discord_status_icon_1",
            "privateinternetaccess"
          ],
          "hidden": [
            "chrome_status_icon_1"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omamail",
          "refreshIntervalSec": 120,
          "maxMessages": 50,
          "heavyMessageRendering": "Show plain text first",
          "contentDirection": "Auto",
          "appearance": "System",
          "defaultQuery": "in:inbox",
          "notifyNewMail": "Off",
          "oauthPort": 9481,
          "undoSendSeconds": 30,
          "unifiedCalendarView": false,
          "showBarIcon": true,
          "unifiedMailboxes": false,
          "suggestEvents": true
        },
        {
          "id": "io.github.elevate08.qs-bitwarden-cli",
          "closeOnCopy": true,
          "colorizeIcon": true,
          "autoLockMinutes": 0,
          "lockOnScreenLock": false,
          "pinUnlock": true
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "ronald.input-sources"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "io.github.orienw.fresh-wallpaper"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omaconnect"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "alwaysShow": true,
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "UTC",
              "zone": "Etc/UTC"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Seattle",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "Miami",
              "zone": "America/New_York"
            },
            {
              "name": "Paris",
              "zone": "Europe/Paris"
            }
          ]
        },
        {
          "id": "io.github.guiestrela.weather",
          "unit": "metric"
        },
        {
          "id": "com.omastorm.radar"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "costafot.markets",
          "stripShowPrice": true
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "brandonpollack23.submap"
        },
        {
          "id": "meviusisback.hw-monitor",
          "mode": "labels",
          "ramFormat": "used/total",
          "tempFormat": "degree"
        }
      ],
      "tray": []
    },
    "position": "bottom",
    "transparent": false
  },
  "cloneSourceRestores": [
    "evindor.keystroke",
    "brpol.notifications",
    "io.github.sirjul1337.lock-explorer"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.notifications",
    "omarchy.lock"
  ],
  "idle": {
    "lock": 900,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "io.github.asmyshlyaev177.last-session"
    },
    {
      "id": "bobbynicholas.omaland"
    },
    {
      "id": "brpol.notifications"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "cipher",
      "unlock": "fade",
      "blankMs": 60000
    }
  ],
  "version": 1
}
