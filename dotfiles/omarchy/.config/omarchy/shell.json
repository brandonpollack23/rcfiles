{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "alwaysShow": true,
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "brandonpollack23.submap"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "brandonpollack23.beautiful-workspace-bar",
          "previewSize": 320
        }
      ],
      "right": [
        {
          "hidden": [],
          "id": "omarchy.tray",
          "pinned": [
            "chrome_status_icon_1",
            "discord_status_icon_1",
            "privateinternetaccess"
          ]
        },
        {
          "id": "ronald.input-sources"
        },
        {
          "id": "io.github.orienw.fresh-wallpaper"
        },
        {
          "id": "omaconnect"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "cloneSourceRestores": [
    "evindor.keystroke"
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "idle": {
    "lock": 900,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "io.github.asmyshlyaev177.last-session"
    },
    {
      "id": "brpol.nous-agent"
    }
  ],
  "version": 1
}
