theme = Dark Modern
font-feature = -calt, -liga, -dlig
macos-option-as-alt = true
copy-on-select = false
shell-integration-features = ssh-terminfo

keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+k=unbind

# No `config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"`
# here on purpose: that include is how Omarchy's theme picker recolours
# ghostty, and I want `theme =` above to win everywhere.
